generator client {
  provider = "middleware-client-js"
  output   = "../generated/middleware"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id          Int             @id @default(autoincrement())
  name        String
  cookingTime String
  calories    String
  image       String?
  createdAt   DateTime        @default(now())
  ingredients Json
  steps       Json
  favorites   FavoriteRecipe?
}

model FavoriteRecipe {
  id          Int      @id @default(autoincrement())
  recipeId    Int?     @unique
  externalId  String?
  name        String
  cookingTime String
  calories    String
  image       String?
  ingredients Json
  steps       Json
  createdAt   DateTime @default(now())
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([externalId])
}
